<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".ArtworkDetailsActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/art_title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_dark"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:id="@+id/art_detail_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_dark"
        android:layout_marginBottom="16dp"
        android:gravity="center"/>

    <TextView
        android:id="@+id/art_artist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="@color/text_dark"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/art_year"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="@color/text_dark"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btn_visit_website"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/visit_website"
        android:backgroundTint="@color/button_enabled"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"
        tools:ignore="VisualLintButtonSize" />

    <Button
        android:id="@+id/btn_back"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/back_to_main"
        android:backgroundTint="@color/text_dark"
        android:textColor="@color/white"
        android:textSize="16sp"
        tools:ignore="VisualLintButtonSize" />

</LinearLayout>